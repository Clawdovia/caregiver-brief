---
import SubscribeForm from './SubscribeForm.astro';
---

<section id="subscribe" class="relative py-28 px-6 overflow-hidden">
  <!-- Dark background -->
  <div class="absolute inset-0" style="background: linear-gradient(135deg, #0a1628 0%, #0d1f3c 60%, #0a1628 100%);"></div>

  <!-- Subtle orb effects -->
  <div class="absolute top-1/4 left-1/4 w-96 h-96 rounded-full opacity-10 blur-3xl"
       style="background: radial-gradient(circle, #1d6a72, transparent);"></div>
  <div class="absolute bottom-1/4 right-1/4 w-96 h-96 rounded-full opacity-10 blur-3xl"
       style="background: radial-gradient(circle, #1d6a72, transparent);"></div>

  <div class="relative max-w-2xl mx-auto text-center space-y-10">

    <!-- Headline -->
    <div class="space-y-4">
      <h2 class="font-serif text-4xl lg:text-5xl text-white leading-tight">
        Start your day with clarity.
      </h2>
      <p class="text-lg text-slate-300 leading-relaxed">
        Free daily intelligence for dementia and Alzheimer's caregivers.
        90 seconds. Every morning at 6:00 AM.
      </p>
    </div>

    <!-- Subscribe Form -->
    <div class="flex justify-center">
      <SubscribeForm dark={true} id="section-subscribe-form" />
    </div>

    <p class="text-xs text-slate-400">
      Free forever &nbsp;·&nbsp; No spam &nbsp;·&nbsp; Unsubscribe anytime
    </p>

    <!-- Glass cards -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-4">
      <div class="glass-card p-5 space-y-2">
        <div class="text-2xl">🌅</div>
        <div class="text-sm font-semibold text-white">Daily</div>
        <p class="text-xs text-slate-400 leading-relaxed">Every morning at 6:00 AM Eastern</p>
      </div>
      <div class="glass-card p-5 space-y-2">
        <div class="text-2xl">💚</div>
        <div class="text-sm font-semibold text-white">Free</div>
        <p class="text-xs text-slate-400 leading-relaxed">Always free. Premium deep dives available soon.</p>
      </div>
      <div class="glass-card p-5 space-y-2">
        <div class="text-2xl">🔒</div>
        <div class="text-sm font-semibold text-white">Private</div>
        <p class="text-xs text-slate-400 leading-relaxed">Your email is never sold or shared. Ever.</p>
      </div>
    </div>

  </div>
</section>
