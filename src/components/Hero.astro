---
import SubscribeForm from './SubscribeForm.astro';
---

<section class="min-h-screen bg-brand-warm flex items-center pt-24 pb-20 px-6">
  <div class="max-w-5xl mx-auto w-full">
    <div class="grid grid-cols-1 lg:grid-cols-5 gap-12 items-center">

      <!-- Left: Copy (3/5) -->
      <div class="lg:col-span-3 space-y-7">
        <div class="inline-flex items-center gap-2 px-4 py-2 neu-pressed">
          <span class="w-2 h-2 rounded-full bg-brand-teal animate-pulse"></span>
          <span class="text-xs font-medium text-brand-teal tracking-widest uppercase">
            6:00 AM Every Morning
          </span>
        </div>

        <h1 class="font-serif text-5xl lg:text-6xl text-brand-text leading-tight">
          90 seconds of clarity<br />
          <em class="not-italic text-brand-teal">every morning.</em>
        </h1>

        <p class="text-lg text-brand-muted leading-relaxed max-w-lg">
          Daily intelligence for dementia and Alzheimer's caregivers.
          Practical guidance. Emotional steadiness. One clear next step.
          Free, every morning before the caregiving day begins.
        </p>

        <!-- Subscribe Form -->
        <div class="space-y-3">
          <SubscribeForm id="hero-subscribe-form" />
          <p class="text-xs text-brand-muted">
            Free forever. No spam. Unsubscribe anytime.
          </p>
        </div>

        <!-- Scripts Bribe -->
        <a href="/scripts" class="inline-flex items-center gap-3 neu-pressed px-4 py-3 group hover:shadow-teal-glow transition-all duration-200">
          <div class="w-8 h-8 rounded-lg bg-brand-teal/10 flex items-center justify-center shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-brand-teal" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
          </div>
          <div>
            <p class="text-xs font-semibold text-brand-text group-hover:text-brand-teal transition-colors">Free with every subscription</p>
            <p class="text-xs text-brand-muted">The Doctor Visit Playbook — 50 scripts for talking to any doctor</p>
          </div>
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-brand-muted group-hover:text-brand-teal transition-colors shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>

      <!-- Right: Sample Brief Card (2/5) -->
      <div class="lg:col-span-2">
        <div class="neu-raised p-6 space-y-4">
          <!-- Card Header -->
          <div class="flex items-center justify-between">
            <div class="neu-pressed px-3 py-1.5">
              <span class="text-xs font-medium text-brand-teal tracking-wider uppercase">Monday · Medical</span>
            </div>
            <span class="text-xs text-brand-muted">90 sec</span>
          </div>

          <!-- Card Title -->
          <h3 class="font-serif text-lg text-brand-text leading-snug">
            The sign families miss most in early Alzheimer's
          </h3>

          <!-- Card Body -->
          <p class="text-sm text-brand-muted leading-relaxed">
            Most families notice memory loss first. But research shows the earliest changes — personality shifts, social withdrawal, losing initiative — often appear <em>years</em> before memory problems begin...
          </p>

          <!-- Tags -->
          <div class="pt-2 space-y-2 border-t border-brand-warm-dark/30">
            <div class="neu-pressed px-3 py-2 flex items-start gap-2">
              <span class="text-xs font-semibold text-brand-teal shrink-0 pt-0.5">QUICK WIN</span>
              <span class="text-xs text-brand-muted">Notice mood changes — not just memory. Document what you see this week.</span>
            </div>
            <div class="neu-pressed px-3 py-2 flex items-start gap-2">
              <span class="text-xs font-semibold text-brand-teal shrink-0 pt-0.5">WORTH KNOWING</span>
              <span class="text-xs text-brand-muted">Alzheimer's Association: behavioral changes can precede memory loss by 2–4 years.</span>
            </div>
          </div>

          <!-- Footer -->
          <div class="flex items-center justify-between pt-1">
            <span class="text-xs text-brand-muted">The Caregiver Brief</span>
            <span class="text-xs text-brand-muted">300–500 words</span>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
